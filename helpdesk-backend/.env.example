# ========================
# DATABASE
# ========================
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/ipb_helpdesk
DATABASE_URL_SYNC=postgresql://postgres:password@localhost:5432/ipb_helpdesk

# ========================
# APP
# ========================
APP_NAME=IPB Help Center API
APP_VERSION=1.0.0
DEBUG=True
SECRET_KEY=ganti-dengan-secret-key-yang-aman-di-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ========================
# CORS (pisah dengan koma)
# ========================
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ========================
# FILE UPLOAD
# ========================
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10
